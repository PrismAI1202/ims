DATABASE_URL="postgresql://ims:ims@localhost:5433/ims?schema=public"
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
COMPANY_NAME="Your Company Name"
COMPANY_GSTIN=""
COMPANY_ADDRESS=""
UPLOAD_DIR="./uploads"
PRINTER_HOST=""
PRINTER_PORT=9100

# ── Vercel only (set in the Vercel project, not here) ──
# DATABASE_URL           pooled connection string from the hosted Postgres (add ?pgbouncer=true&connection_limit=1 for a pooler)
# DATABASE_URL_UNPOOLED  direct connection string, used only to run migrations during the build (or DIRECT_URL)
# BLOB_READ_WRITE_TOKEN  from a private Vercel Blob store; uploads go there instead of UPLOAD_DIR
