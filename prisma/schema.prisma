generator client {
  provider      = "prisma-client-js"
  // "native" is whatever machine generates the client (dev, Docker, CI); rhel is Vercel's runtime, which CI does not run on.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────

enum Segment {
  AUTOMOTIVE
  NON_AUTOMOTIVE
}

enum ItemCategory {
  RM_RESIN
  RM_MASTERBATCH
  RM_ADDITIVE
  RM_FILLER
  BOP
  PACKAGING
  RETURNABLE
  FG
  REGRIND
}

enum PoStatus {
  DRAFT
  APPROVED
  PARTIAL
  CLOSED
  CANCELLED
}

// Final inspection of a finished-goods lot before it may ship. NOT_REQUIRED covers everything that isn't FG
// production (and lots made before PDI existed).
enum PdiStatus {
  NOT_REQUIRED
  PENDING
  RELEASED
  HOLD
}

enum QcStatus {
  PENDING_QC
  APPROVED
  REJECTED
  DEVIATED
}

enum LocationType {
  STAGING
  STORAGE
}

enum TxnType {
  GRN_IN
  QC_RELEASE
  TRANSFER
  ISSUE
  RETURN
  PRODUCTION_IN
  REGRIND_IN
  SCRAP
  DISPATCH
  RTV_OUT
  ADJUST
}

enum RequestStatus {
  OPEN
  PARTIAL
  ISSUED
  CANCELLED
}

// ───────── Users & API tokens ─────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String // AccessRole.key
  access       AccessRole @relation(fields: [role], references: [key])
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  tokens       ApiToken[]
  pushes       PushSubscription[]
}

// A role is a named set of screens (views) and actions (permissions); see src/lib/views.ts and
// src/server/auth/permissions.ts. System roles come from the migration; admins add their own under Settings.
model AccessRole {
  key         String   @id
  name        String   @unique
  description String   @default("")
  system      Boolean  @default(false)
  allAccess   Boolean  @default(false) // every view and permission, including ones added later
  views       String[]
  permissions String[]
  home        String[] // Home widgets in order; see src/lib/home-widgets.ts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// ───────── Masters ─────────

model Customer {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  segment     Segment
  labelFormat String             @default("GENERIC") // GENERIC | OEM
  gstin       String?
  address     String?
  active      Boolean            @default(true)
  boxes       FgBox[]
  dispatches  Dispatch[]
  returnables ReturnableLedger[]
  demandLines DemandLine[]
}

model Supplier {
  equivalentGrades EquivalentGrade[]
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  leadTimeDays     Int               @default(7)
  active           Boolean           @default(true)
  pos              PurchaseOrder[]
  prices           PriceMaster[]
  returns          ReturnToVendor[]
}

model Item {
  equivalentGroup  EquivalentGroup?
  id               String                @id @default(cuid())
  code             String                @unique
  name             String
  category         ItemCategory
  uom              String                @default("KG")
  polymerGrade     String? // e.g. PP, ABS, PA66
  minStock         Decimal               @default(0) @db.Decimal(14, 3)
  maxStock         Decimal               @default(0) @db.Decimal(14, 3)
  reorderPoint     Decimal               @default(0) @db.Decimal(14, 3)
  safetyStock      Decimal               @default(0) @db.Decimal(14, 3)
  shelfLifeDays    Int?
  requiresCoa      Boolean               @default(false)
  maxRegrindPct    Decimal?              @db.Decimal(5, 2)
  hsnCode          String?
  unitPrice        Decimal?              @db.Decimal(14, 4) // selling price, FG only
  active           Boolean               @default(true)
  dispatchLines    DispatchLine[]
  returnableLedger ReturnableLedger[]
  demandLines      DemandLine[]
  stockTracked     Boolean               @default(false) // returnable containers only: true = we own them and track their stock
  prices           PriceMaster[]
  poLines          PurchaseOrderLine[]
  lots             Lot[]
  requestLines     MaterialRequestLine[]
  boms             Bom[]
  bomLines         BomLine[]
  consumption      BookingConsumption[]
}

model PriceMaster {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  price      Decimal  @db.Decimal(14, 4)
  validFrom  DateTime @default(now())

  @@unique([itemId, supplierId])
}

model Warehouse {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  locations Location[]
}

model Location {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  code        String             @unique // scannable bin barcode, e.g. A-01-03
  rack        String
  shelf       String
  bin         String
  type        LocationType       @default(STORAGE)
  active      Boolean            @default(true) // false: removed from the layout but kept, because stock history points at it
  balances    StockBalance[]
  txns        StockTransaction[]
  boxes       FgBox[]
  counts      StockCount[]
}

model Machine {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  tonnage   Int?
  active    Boolean             @default(true) // false: retired, but kept because bookings, stops and plans point at it
  moulds    Mould[]
  bookings  ProductionBooking[]
  downtimes Downtime[]
  planSlots PlanSlot[]
  firstOffs FirstOff[]
}

model Mould {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  cavities        Int            @default(1)
  shotWeightG     Decimal?       @db.Decimal(10, 2)
  runnerWeightG   Decimal?       @db.Decimal(10, 2)
  machineId       String?
  machine         Machine?       @relation(fields: [machineId], references: [id])
  active          Boolean        @default(true) // false: retired, but kept because PM and repair history points at it
  boms            Bom[]
  // Performance and planning: standard cycle time and the smallest press this mould can run on.
  idealCycleSec   Decimal?       @db.Decimal(7, 2)
  minTonnage      Int?
  // Maintenance: shots = openingShots + shots booked in production; a PM is due every pmIntervalShots.
  openingShots    Int            @default(0)
  lifeShots       Int            @default(1000000)
  pmIntervalShots Int            @default(50000)
  lastPmShots     Int            @default(0)
  pmRecords       PmRecord[]
  repairs         RepairTicket[]
  downtimes       Downtime[]
  planSlots       PlanSlot[]
}

// ───────── Phase 2: BOM and production ─────────

enum BomLineKind {
  RESIN
  MASTERBATCH
  REGRIND
  BOP
  PACKAGING
}

enum Shift {
  A
  B
  C
}

// One BOM per finished part. RESIN/MASTERBATCH/REGRIND lines are a weight blend (pct sums to 100);
// BOP/PACKAGING lines are a count per good part.
model Bom {
  id          String              @id @default(cuid())
  fgItemId    String              @unique
  fgItem      Item                @relation(fields: [fgItemId], references: [id])
  mouldId     String
  mould       Mould               @relation(fields: [mouldId], references: [id])
  partWeightG Decimal             @db.Decimal(10, 3) // net weight of one moulded part
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       BomLine[]
  bookings    ProductionBooking[]
  firstOffs   FirstOff[]
}

model BomLine {
  id         String      @id @default(cuid())
  bomId      String
  bom        Bom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item        @relation(fields: [itemId], references: [id])
  kind       BomLineKind
  pct        Decimal?    @db.Decimal(7, 3) // blend lines only
  qtyPerPart Decimal?    @db.Decimal(12, 4) // BOP / packaging only
}

model ProductionBooking {
  id            String               @id @default(cuid())
  bookingNumber String               @unique
  bomId         String
  bom           Bom                  @relation(fields: [bomId], references: [id])
  machineId     String
  machine       Machine              @relation(fields: [machineId], references: [id])
  shift         Shift
  shots         Int
  goodParts     Int
  rejectParts   Int                  @default(0)
  runnerKg      Decimal              @default(0) @db.Decimal(12, 3) // runner/sprue generated
  regrindLotId  String?
  fgLotId       String?
  producedAt    DateTime             @default(now())
  userId        String?
  note          String?
  consumption   BookingConsumption[]
  lotUses       ProductionLotUse[]
  scrap         ScrapDisposition[]

  @@index([producedAt])
}

// Expected material use frozen at booking time, so later BOM edits don't rewrite history.
model BookingConsumption {
  id          String            @id @default(cuid())
  bookingId   String
  booking     ProductionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item              @relation(fields: [itemId], references: [id])
  expectedQty Decimal           @db.Decimal(14, 4)
}

// ───────── Procurement ─────────

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  externalRef String? // the supplier-facing or other system's PO number, when POs are also tracked elsewhere
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  segment     Segment             @default(NON_AUTOMOTIVE)
  status      PoStatus            @default(DRAFT)
  createdAt   DateTime            @default(now())
  createdById String?
  lines       PurchaseOrderLine[]
  gateEntries GateEntry[]
  grns        Grn[]

  @@unique([supplierId, externalRef]) // an imported PO can't be loaded twice
}

model PurchaseOrderLine {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item          @relation(fields: [itemId], references: [id])
  qty          Decimal       @db.Decimal(14, 3)
  receivedQty  Decimal       @default(0) @db.Decimal(14, 3)
  price        Decimal       @db.Decimal(14, 4)
  expectedDate DateTime?
  grnLines     GrnLine[]
}

// ───────── Inward: gate entry, GRN, lots, QC ─────────

model GateEntry {
  id            String         @id @default(cuid())
  entryNumber   String         @unique
  poId          String?
  po            PurchaseOrder? @relation(fields: [poId], references: [id])
  vehicleNumber String
  invoiceNumber String
  arrivedAt     DateTime       @default(now())
  grns          Grn[]
}

model Grn {
  id          String        @id @default(cuid())
  grnNumber   String        @unique
  gateEntryId String?
  gateEntry   GateEntry?    @relation(fields: [gateEntryId], references: [id])
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  coaUrl      String? // COA attachment (stored filename / URL)
  createdAt   DateTime      @default(now())
  createdById String?
  lines       GrnLine[]
}

model GrnLine {
  id       String            @id @default(cuid())
  grnId    String
  grn      Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId String
  poLine   PurchaseOrderLine @relation(fields: [poLineId], references: [id])
  lot      Lot?
}

model Lot {
  id            String             @id @default(cuid())
  lotNumber     String             @unique // internal, printed on QR tag
  itemId        String
  item          Item               @relation(fields: [itemId], references: [id])
  grnLineId     String?            @unique
  grnLine       GrnLine?           @relation(fields: [grnLineId], references: [id])
  supplierLotNo String // manufacturer lot / heat number
  bags          Int?
  receivedQty   Decimal            @db.Decimal(14, 3)
  receivedAt    DateTime           @default(now())
  expiryDate    DateTime?
  qcStatus      QcStatus           @default(PENDING_QC)
  pdiStatus     PdiStatus          @default(NOT_REQUIRED)
  pdiNote       String?
  pdiById       String?
  pdiAt         DateTime?
  inspections   QcInspection[]
  balances      StockBalance[]
  txns          StockTransaction[]
  issueLines    IssueLine[]
  boxes         FgBox[]
  lotUses       ProductionLotUse[]
  countLines    StockCountLine[]
  returns       ReturnToVendor[]

  @@index([itemId, qcStatus, receivedAt])
}

model QcInspection {
  id            String   @id @default(cuid())
  lotId         String
  lot           Lot      @relation(fields: [lotId], references: [id])
  mfi           Decimal? @db.Decimal(10, 3)
  moisturePct   Decimal? @db.Decimal(6, 3)
  density       Decimal? @db.Decimal(8, 4)
  tensile       Decimal? @db.Decimal(10, 3)
  decision      QcStatus
  remarks       String?
  coaUrl        String?
  countedQty    Decimal? @db.Decimal(14, 3) // what the inspector counted in staging, against the GRN quantity
  inspectedAt   DateTime @default(now())
  inspectedById String?
}

// ───────── Stock ─────────

model StockBalance {
  id         String   @id @default(cuid())
  lotId      String
  lot        Lot      @relation(fields: [lotId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  qty        Decimal  @db.Decimal(14, 3)

  @@unique([lotId, locationId])
}

model StockTransaction {
  id         String    @id @default(cuid())
  type       TxnType
  lotId      String
  lot        Lot       @relation(fields: [lotId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  qty        Decimal   @db.Decimal(14, 3) // signed: + in, - out
  refType    String? // GRN | QC | ISSUE | TRANSFER ...
  refId      String?
  clientUuid String?   @unique // idempotency key for offline sync
  note       String?
  userId     String?
  createdAt  DateTime  @default(now())

  @@index([lotId])
}

// ───────── Shop floor ─────────

model MaterialRequest {
  id            String                @id @default(cuid())
  requestNumber String                @unique
  status        RequestStatus         @default(OPEN)
  machineId     String?
  requestedById String?
  createdAt     DateTime              @default(now())
  lines         MaterialRequestLine[]
}

model MaterialRequestLine {
  id        String          @id @default(cuid())
  requestId String
  request   MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item            @relation(fields: [itemId], references: [id])
  qty       Decimal         @db.Decimal(14, 3)
  issuedQty Decimal         @default(0) @db.Decimal(14, 3)
  issues    IssueLine[]
}

model IssueLine {
  id                 String              @id @default(cuid())
  requestLineId      String
  requestLine        MaterialRequestLine @relation(fields: [requestLineId], references: [id])
  lotId              String
  lot                Lot                 @relation(fields: [lotId], references: [id])
  qty                Decimal             @db.Decimal(14, 3)
  fifoOverrideReason String?
  clientUuid         String?             @unique
  issuedById         String?
  issuedAt           DateTime            @default(now())
}

// ───────── Phase 3: FG boxes, dispatch, returnables ─────────

enum BoxStatus {
  IN_STOCK
  DISPATCHED
}

enum DispatchStatus {
  LOADING
  DISPATCHED
  CANCELLED
}

enum ReturnableMove {
  ISSUED
  RETURNED
}

// A labelled box of finished parts. Stock lives on the lot's balance; a box only reserves part of it
// until it is scanned onto a truck.
model FgBox {
  id           String    @id @default(cuid())
  boxCode      String    @unique // human + QR key
  lotId        String
  lot          Lot       @relation(fields: [lotId], references: [id])
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  qty          Int
  shift        String? // snapshot for the label
  machineCode  String?
  batchCode    String? // production booking number
  producedDate DateTime
  status       BoxStatus @default(IN_STOCK)
  dispatchId   String?
  dispatch     Dispatch? @relation(fields: [dispatchId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([lotId, status])
  @@index([dispatchId])
}

model Dispatch {
  id            String             @id @default(cuid())
  dcNumber      String             @unique
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id])
  vehicleNumber String? // optional: bulk OEM orders aren't tied to one vehicle; it is added when the load leaves (e-way bill, challan)
  driverName    String?
  status        DispatchStatus     @default(LOADING)
  createdAt     DateTime           @default(now())
  dispatchedAt  DateTime?
  createdById   String?
  lines         DispatchLine[]
  boxes         FgBox[]
  returnables   ReturnableLedger[]
}

model DispatchLine {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  qty        Int
}

// Customer-owned crates, trolleys and pallets: issued with a dispatch, returned later. Balance = issued - returned.
model ReturnableLedger {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  itemId     String
  item       Item           @relation(fields: [itemId], references: [id])
  move       ReturnableMove
  qty        Int
  dispatchId String?
  dispatch   Dispatch?      @relation(fields: [dispatchId], references: [id])
  note       String?
  userId     String?
  createdAt  DateTime       @default(now())

  @@index([customerId, itemId])
}

// ───────── Phase 4: demand and MRP ─────────

enum DemandType {
  FORECAST
  FIRM
  SPOT
}

model DemandImport {
  id        String       @id @default(cuid())
  fileName  String
  rowCount  Int
  replaced  Int          @default(0) // forecast rows superseded by this upload
  userId    String?
  createdAt DateTime     @default(now())
  lines     DemandLine[]
}

model DemandLine {
  id         String        @id @default(cuid())
  importId   String?
  import     DemandImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  fgItemId   String
  fgItem     Item          @relation(fields: [fgItemId], references: [id])
  dueDate    DateTime      @db.Date
  qty        Int
  shippedQty Int           @default(0) // how much of a firm or spot order has gone out on completed dispatches (see allocateShipment)
  type       DemandType
  createdAt  DateTime      @default(now())

  @@index([dueDate])
  @@index([customerId, fgItemId, type])
}

// ───────── Phase 5: traceability and scrap ─────────

// Which material lots a production run actually consumed (stock was already issued; this is the trace link).
model ProductionLotUse {
  id        String            @id @default(cuid())
  bookingId String
  booking   ProductionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lotId     String
  lot       Lot               @relation(fields: [lotId], references: [id])
  qty       Decimal           @db.Decimal(14, 3)

  @@index([lotId])
  @@index([bookingId])
}

enum ScrapKind {
  REGRIND
  WASTE
}

// QA's decision on rejected parts from a booking: crush into regrind, or scrap as waste.
model ScrapDisposition {
  id           String            @id @default(cuid())
  bookingId    String
  booking      ProductionBooking @relation(fields: [bookingId], references: [id])
  parts        Int
  weightKg     Decimal           @db.Decimal(12, 3)
  kind         ScrapKind
  regrindLotId String?
  note         String?
  approvedById String?
  createdAt    DateTime          @default(now())

  @@index([bookingId])
}

// ───────── Phase 6: equivalents, maintenance, planning, downtime ─────────

// One spec, many vendor grades. A group represents one stock item; each grade is a supplier's version of it.
// Grade stock is derived: on-hand lots of that item that arrived on a PO from the grade's supplier.
model EquivalentGroup {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  itemId    String            @unique
  item      Item              @relation(fields: [itemId], references: [id])
  spec      String            @default("") // key spec values, comma separated
  createdAt DateTime          @default(now())
  grades    EquivalentGrade[]
}

enum GradeStatus {
  PENDING_QA
  APPROVED
  REJECTED
}

model EquivalentGrade {
  id            String          @id @default(cuid())
  groupId       String
  group         EquivalentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  gradeName     String
  supplierId    String
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  status        GradeStatus     @default(PENDING_QA)
  autoApproved  Boolean         @default(false) // true: may be used for automotive parts too
  priority      Int             @default(100) // lower = preferred
  leadTimeDays  Int?
  datasheetRef  String?
  trialRef      String?
  note          String?
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@unique([groupId, gradeName, supplierId])
}

enum DowntimeReason {
  MOULD_CHANGE
  MOULD_REPAIR
  MACHINE_BREAKDOWN
  NO_MATERIAL
  NO_OPERATOR
  NO_PLAN
  POWER_CUT
  QC_HOLD
  COLOUR_CHANGE
  TRIAL
}

// Minutes a machine was stopped in a shift, with the reason. Feeds OEE availability and MTBF / MTTR.
model Downtime {
  id        String         @id @default(cuid())
  machineId String
  machine   Machine        @relation(fields: [machineId], references: [id])
  mouldId   String?
  mould     Mould?         @relation(fields: [mouldId], references: [id])
  day       DateTime       @db.Date
  shift     Shift
  reason    DowntimeReason
  minutes   Int
  note      String?
  userId    String?
  createdAt DateTime       @default(now())

  @@index([day])
  @@index([machineId, day])
}

model PmRecord {
  id        String   @id @default(cuid())
  mouldId   String
  mould     Mould    @relation(fields: [mouldId], references: [id])
  shotsAtPm Int
  checks    String // the checklist items that were ticked, one per line
  photoRef  String
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([mouldId, createdAt])
}

enum RepairKind {
  REPAIR
  TRIAL
}

model RepairTicket {
  id          String     @id @default(cuid())
  mouldId     String
  mould       Mould      @relation(fields: [mouldId], references: [id])
  kind        RepairKind @default(REPAIR)
  summary     String
  downtimeMin Int        @default(0)
  photoRef    String?
  note        String?
  userId      String?
  createdAt   DateTime   @default(now())

  @@index([mouldId, createdAt])
}

enum PlanKind {
  JOB
  PM
  TRIAL
}

// One machine-day in the weekly mould x machine plan.
model PlanSlot {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id])
  day       DateTime @db.Date
  kind      PlanKind @default(JOB)
  mouldId   String?
  mould     Mould?   @relation(fields: [mouldId], references: [id])
  fgItemId  String? // the part being made, for JOB slots
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  @@unique([machineId, day])
  @@index([day])
}

// Small key/value settings (e.g. shift length in minutes).
model AppSetting {
  key   String @id
  value String
}

// ───────── Stock count and adjustment ─────────

enum CountStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

// A physical count of one bin. Store snapshots the system quantities, enters what is really there, and submits;
// an approver decides. Approval writes ADJUST ledger rows for the differences.
model StockCount {
  id          String           @id @default(cuid())
  countNumber String           @unique
  locationId  String
  location    Location         @relation(fields: [locationId], references: [id])
  status      CountStatus      @default(OPEN)
  countedById String?
  submittedAt DateTime?
  decidedById String?
  decidedAt   DateTime?
  note        String? // the approver's remark (required to reject)
  createdAt   DateTime         @default(now())
  lines       StockCountLine[]

  @@index([status])
}

model StockCountLine {
  id         String     @id @default(cuid())
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  lotId      String
  lot        Lot        @relation(fields: [lotId], references: [id])
  systemQty  Decimal    @db.Decimal(14, 3) // what the system held when the count started
  countedQty Decimal?   @db.Decimal(14, 3) // null until entered

  @@unique([countId, lotId])
}

// ───────── Returns to supplier ─────────

// A rejected lot sent back to its supplier. Posting removes the stock and the debit note is the paperwork that goes with it.
model ReturnToVendor {
  id              String   @id @default(cuid())
  rtvNumber       String   @unique
  debitNoteNumber String   @unique
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  lotId           String
  lot             Lot      @relation(fields: [lotId], references: [id])
  qty             Decimal  @db.Decimal(14, 3)
  unitPrice       Decimal  @db.Decimal(14, 4) // from the PO line the lot was received against
  reason          String
  createdById     String?
  createdAt       DateTime @default(now())

  @@index([lotId])
}

// ───────── First-off approval ─────────

enum FirstOffStatus {
  PENDING
  APPROVED
  REJECTED
}

// Production asks QA to check the first parts off a new set-up; once approved, the run may be booked
// (when the plant rule is on). An approval holds for 24 hours for that machine, part and shift.
model FirstOff {
  id            String         @id @default(cuid())
  machineId     String
  machine       Machine        @relation(fields: [machineId], references: [id])
  bomId         String
  bom           Bom            @relation(fields: [bomId], references: [id])
  shift         Shift
  status        FirstOffStatus @default(PENDING)
  note          String? // from the requester
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime       @default(now())

  @@index([machineId, bomId, status])
  @@index([status])
}

// ───────── Push notifications ─────────

// One browser or phone that has agreed to notifications. Dead ones (the push service answers 404/410) are deleted on send.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
