generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────

enum Role {
  ADMIN
  STORE_INCHARGE
  QA_INSPECTOR
  PRODUCTION_LEAD
  DISPATCH_OFFICER
}

enum Segment {
  AUTOMOTIVE
  NON_AUTOMOTIVE
}

enum ItemCategory {
  RM_RESIN
  RM_MASTERBATCH
  RM_ADDITIVE
  RM_FILLER
  BOP
  PACKAGING
  RETURNABLE
  FG
  REGRIND
}

enum PoStatus {
  DRAFT
  APPROVED
  PARTIAL
  CLOSED
  CANCELLED
}

enum QcStatus {
  PENDING_QC
  APPROVED
  REJECTED
  DEVIATED
}

enum LocationType {
  STAGING
  STORAGE
}

enum TxnType {
  GRN_IN
  QC_RELEASE
  TRANSFER
  ISSUE
  RETURN
  PRODUCTION_IN
  REGRIND_IN
  SCRAP
  DISPATCH
  ADJUST
}

enum RequestStatus {
  OPEN
  PARTIAL
  ISSUED
  CANCELLED
}

// ───────── Users & API tokens ─────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  tokens       ApiToken[]
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// ───────── Masters ─────────

model Customer {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  segment     Segment
  labelFormat String             @default("GENERIC") // GENERIC | OEM
  gstin       String?
  address     String?
  active      Boolean            @default(true)
  boxes       FgBox[]
  dispatches  Dispatch[]
  returnables ReturnableLedger[]
}

model Supplier {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  leadTimeDays Int             @default(7)
  active       Boolean         @default(true)
  pos          PurchaseOrder[]
  prices       PriceMaster[]
}

model Item {
  id               String                @id @default(cuid())
  code             String                @unique
  name             String
  category         ItemCategory
  uom              String                @default("KG")
  polymerGrade     String? // e.g. PP, ABS, PA66
  minStock         Decimal               @default(0) @db.Decimal(14, 3)
  maxStock         Decimal               @default(0) @db.Decimal(14, 3)
  reorderPoint     Decimal               @default(0) @db.Decimal(14, 3)
  safetyStock      Decimal               @default(0) @db.Decimal(14, 3)
  shelfLifeDays    Int?
  requiresCoa      Boolean               @default(false)
  maxRegrindPct    Decimal?              @db.Decimal(5, 2)
  hsnCode          String?
  unitPrice        Decimal?              @db.Decimal(14, 4) // selling price, FG only
  active           Boolean               @default(true)
  dispatchLines    DispatchLine[]
  returnableLedger ReturnableLedger[]
  prices           PriceMaster[]
  poLines          PurchaseOrderLine[]
  lots             Lot[]
  requestLines     MaterialRequestLine[]
  boms             Bom[]
  bomLines         BomLine[]
  consumption      BookingConsumption[]
}

model PriceMaster {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  price      Decimal  @db.Decimal(14, 4)
  validFrom  DateTime @default(now())

  @@unique([itemId, supplierId])
}

model Warehouse {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  locations Location[]
}

model Location {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  code        String             @unique // scannable bin barcode, e.g. A-01-03
  rack        String
  shelf       String
  bin         String
  type        LocationType       @default(STORAGE)
  balances    StockBalance[]
  txns        StockTransaction[]
  boxes       FgBox[]
}

model Machine {
  id       String              @id @default(cuid())
  code     String              @unique
  name     String
  tonnage  Int?
  moulds   Mould[]
  bookings ProductionBooking[]
}

model Mould {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  cavities      Int      @default(1)
  shotWeightG   Decimal? @db.Decimal(10, 2)
  runnerWeightG Decimal? @db.Decimal(10, 2)
  machineId     String?
  machine       Machine? @relation(fields: [machineId], references: [id])
  boms          Bom[]
}

// ───────── Phase 2: BOM and production ─────────

enum BomLineKind {
  RESIN
  MASTERBATCH
  REGRIND
  BOP
  PACKAGING
}

enum Shift {
  A
  B
  C
}

// One BOM per finished part. RESIN/MASTERBATCH/REGRIND lines are a weight blend (pct sums to 100);
// BOP/PACKAGING lines are a count per good part.
model Bom {
  id          String              @id @default(cuid())
  fgItemId    String              @unique
  fgItem      Item                @relation(fields: [fgItemId], references: [id])
  mouldId     String
  mould       Mould               @relation(fields: [mouldId], references: [id])
  partWeightG Decimal             @db.Decimal(10, 3) // net weight of one moulded part
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       BomLine[]
  bookings    ProductionBooking[]
}

model BomLine {
  id         String      @id @default(cuid())
  bomId      String
  bom        Bom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item        @relation(fields: [itemId], references: [id])
  kind       BomLineKind
  pct        Decimal?    @db.Decimal(7, 3) // blend lines only
  qtyPerPart Decimal?    @db.Decimal(12, 4) // BOP / packaging only
}

model ProductionBooking {
  id            String               @id @default(cuid())
  bookingNumber String               @unique
  bomId         String
  bom           Bom                  @relation(fields: [bomId], references: [id])
  machineId     String
  machine       Machine              @relation(fields: [machineId], references: [id])
  shift         Shift
  shots         Int
  goodParts     Int
  rejectParts   Int                  @default(0)
  runnerKg      Decimal              @default(0) @db.Decimal(12, 3) // runner/sprue generated
  regrindLotId  String?
  fgLotId       String?
  producedAt    DateTime             @default(now())
  userId        String?
  note          String?
  consumption   BookingConsumption[]

  @@index([producedAt])
}

// Expected material use frozen at booking time, so later BOM edits don't rewrite history.
model BookingConsumption {
  id          String            @id @default(cuid())
  bookingId   String
  booking     ProductionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item              @relation(fields: [itemId], references: [id])
  expectedQty Decimal           @db.Decimal(14, 4)
}

// ───────── Procurement ─────────

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  segment     Segment             @default(NON_AUTOMOTIVE)
  status      PoStatus            @default(DRAFT)
  createdAt   DateTime            @default(now())
  createdById String?
  lines       PurchaseOrderLine[]
  gateEntries GateEntry[]
  grns        Grn[]
}

model PurchaseOrderLine {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item          @relation(fields: [itemId], references: [id])
  qty          Decimal       @db.Decimal(14, 3)
  receivedQty  Decimal       @default(0) @db.Decimal(14, 3)
  price        Decimal       @db.Decimal(14, 4)
  expectedDate DateTime?
  grnLines     GrnLine[]
}

// ───────── Inward: gate entry, GRN, lots, QC ─────────

model GateEntry {
  id            String         @id @default(cuid())
  entryNumber   String         @unique
  poId          String?
  po            PurchaseOrder? @relation(fields: [poId], references: [id])
  vehicleNumber String
  invoiceNumber String
  arrivedAt     DateTime       @default(now())
  grns          Grn[]
}

model Grn {
  id          String        @id @default(cuid())
  grnNumber   String        @unique
  gateEntryId String?
  gateEntry   GateEntry?    @relation(fields: [gateEntryId], references: [id])
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  coaUrl      String? // COA attachment (stored filename / URL)
  createdAt   DateTime      @default(now())
  createdById String?
  lines       GrnLine[]
}

model GrnLine {
  id       String            @id @default(cuid())
  grnId    String
  grn      Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId String
  poLine   PurchaseOrderLine @relation(fields: [poLineId], references: [id])
  lot      Lot?
}

model Lot {
  id            String             @id @default(cuid())
  lotNumber     String             @unique // internal, printed on QR tag
  itemId        String
  item          Item               @relation(fields: [itemId], references: [id])
  grnLineId     String?            @unique
  grnLine       GrnLine?           @relation(fields: [grnLineId], references: [id])
  supplierLotNo String // manufacturer lot / heat number
  bags          Int?
  receivedQty   Decimal            @db.Decimal(14, 3)
  receivedAt    DateTime           @default(now())
  expiryDate    DateTime?
  qcStatus      QcStatus           @default(PENDING_QC)
  inspections   QcInspection[]
  balances      StockBalance[]
  txns          StockTransaction[]
  issueLines    IssueLine[]
  boxes         FgBox[]

  @@index([itemId, qcStatus, receivedAt])
}

model QcInspection {
  id            String   @id @default(cuid())
  lotId         String
  lot           Lot      @relation(fields: [lotId], references: [id])
  mfi           Decimal? @db.Decimal(10, 3)
  moisturePct   Decimal? @db.Decimal(6, 3)
  density       Decimal? @db.Decimal(8, 4)
  tensile       Decimal? @db.Decimal(10, 3)
  decision      QcStatus
  remarks       String?
  coaUrl        String?
  inspectedAt   DateTime @default(now())
  inspectedById String?
}

// ───────── Stock ─────────

model StockBalance {
  id         String   @id @default(cuid())
  lotId      String
  lot        Lot      @relation(fields: [lotId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  qty        Decimal  @db.Decimal(14, 3)

  @@unique([lotId, locationId])
}

model StockTransaction {
  id         String    @id @default(cuid())
  type       TxnType
  lotId      String
  lot        Lot       @relation(fields: [lotId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  qty        Decimal   @db.Decimal(14, 3) // signed: + in, - out
  refType    String? // GRN | QC | ISSUE | TRANSFER ...
  refId      String?
  clientUuid String?   @unique // idempotency key for offline sync
  note       String?
  userId     String?
  createdAt  DateTime  @default(now())

  @@index([lotId])
}

// ───────── Shop floor ─────────

model MaterialRequest {
  id            String                @id @default(cuid())
  requestNumber String                @unique
  status        RequestStatus         @default(OPEN)
  machineId     String?
  requestedById String?
  createdAt     DateTime              @default(now())
  lines         MaterialRequestLine[]
}

model MaterialRequestLine {
  id        String          @id @default(cuid())
  requestId String
  request   MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item            @relation(fields: [itemId], references: [id])
  qty       Decimal         @db.Decimal(14, 3)
  issuedQty Decimal         @default(0) @db.Decimal(14, 3)
  issues    IssueLine[]
}

model IssueLine {
  id                 String              @id @default(cuid())
  requestLineId      String
  requestLine        MaterialRequestLine @relation(fields: [requestLineId], references: [id])
  lotId              String
  lot                Lot                 @relation(fields: [lotId], references: [id])
  qty                Decimal             @db.Decimal(14, 3)
  fifoOverrideReason String?
  clientUuid         String?             @unique
  issuedById         String?
  issuedAt           DateTime            @default(now())
}

// ───────── Phase 3: FG boxes, dispatch, returnables ─────────

enum BoxStatus {
  IN_STOCK
  DISPATCHED
}

enum DispatchStatus {
  LOADING
  DISPATCHED
  CANCELLED
}

enum ReturnableMove {
  ISSUED
  RETURNED
}

// A labelled box of finished parts. Stock lives on the lot's balance; a box only reserves part of it
// until it is scanned onto a truck.
model FgBox {
  id           String    @id @default(cuid())
  boxCode      String    @unique // human + QR key
  lotId        String
  lot          Lot       @relation(fields: [lotId], references: [id])
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  qty          Int
  shift        String? // snapshot for the label
  machineCode  String?
  batchCode    String? // production booking number
  producedDate DateTime
  status       BoxStatus @default(IN_STOCK)
  dispatchId   String?
  dispatch     Dispatch? @relation(fields: [dispatchId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([lotId, status])
  @@index([dispatchId])
}

model Dispatch {
  id            String             @id @default(cuid())
  dcNumber      String             @unique
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id])
  vehicleNumber String
  driverName    String?
  status        DispatchStatus     @default(LOADING)
  createdAt     DateTime           @default(now())
  dispatchedAt  DateTime?
  createdById   String?
  lines         DispatchLine[]
  boxes         FgBox[]
  returnables   ReturnableLedger[]
}

model DispatchLine {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  qty        Int
}

// Customer-owned crates, trolleys and pallets: issued with a dispatch, returned later. Balance = issued - returned.
model ReturnableLedger {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  itemId     String
  item       Item           @relation(fields: [itemId], references: [id])
  move       ReturnableMove
  qty        Int
  dispatchId String?
  dispatch   Dispatch?      @relation(fields: [dispatchId], references: [id])
  note       String?
  userId     String?
  createdAt  DateTime       @default(now())

  @@index([customerId, itemId])
}
